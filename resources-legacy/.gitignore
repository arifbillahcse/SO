# ===== Environment & secrets (NEVER commit these) =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
auth.json

# ===== Laravel =====
/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/public
!/storage/app/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep
/.phpunit.cache
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# ===== Database (local dev only) =====
*.sqlite
*.sqlite-journal
database/database.sqlite

# ===== Build artifacts =====
/public/build
/public/mix-manifest.json

# ===== IDE / editor =====
/.idea
/.vscode
/.fleet
/.nova
/.zed
*.swp
*.swo

# ===== OS files =====
.DS_Store
Thumbs.db

# ===== Logs =====
*.log
